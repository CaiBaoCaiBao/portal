{
  "name": "app",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "shadcn": "pnpm dlx shadcn@latest add",
    "test": "vitest",
    "contract:emit": "prisma contract emit",
    "db:init:dev": "cmd /c \"set NODE_ENV=development&& prisma db init\"",
    "db:init:test": "cmd /c \"set NODE_ENV=test&& prisma db init\"",
    "db:init:prod": "cmd /c \"set NODE_ENV=production&& prisma db init\"",
    "db:update:dev": "cmd /c \"set NODE_ENV=development&& prisma db update\"",
    "db:update:test": "cmd /c \"set NODE_ENV=test&& prisma db update\"",
    "db:update:prod": "cmd /c \"set NODE_ENV=production&& prisma db update\"",
    "db:sync": "pnpm db:update:dev && pnpm db:update:test && pnpm db:update:prod"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/orm-postgres": "8.0.0-rc.13",
