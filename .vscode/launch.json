{
    "version": "0.2.0",
    "configurations": [
      {
        "name": "Next.js: debug server-side",
        "type": "node-terminal",
        "request": "launch",
        "command": "pnpm dev",
        "cwd": "${workspaceFolder}/app"
      },
      {
        "name": "Next.js: debug client-side",
        "type": "chrome",
        "request": "launch",
        "url": "http://localhost:3000"
      }
    ],
    "compounds": [
      {
        "name": "Next.js: full stack",
        "configurations": [
          "Next.js: debug server-side",
          "Next.js: debug client-side"
        ]
      }
    ]
  }